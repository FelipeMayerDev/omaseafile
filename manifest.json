{
  "schemaVersion": 1,
  "id": "io.github.felipemayerdev.omaseafile",
  "name": "OmaSeafile",
  "version": "1.2.0",
  "author": "Felipe Mayer",
  "license": "MIT",
  "description": "Seafile in the Omarchy bar: synced libraries, live state, size on disk, server libraries, starred items and transfer notifications. It starts its own seaf-daemon and connects to the server by itself — the Seafile desktop client is optional.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaSeafile",
    "description": "Local and server libraries, starred items, download progress, daemon control and notifications. Does not depend on the Seafile desktop client.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "interval": 10,
      "notifyTransfers": true,
      "remoteInterval": 60,
      "autostart": true
    },
    "schema": [
      {
        "key": "interval",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "remoteInterval",
        "type": "integer",
        "label": "Server tabs interval (seconds)",
        "min": 15,
        "max": 900,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "autostart",
        "type": "boolean",
        "label": "Start seaf-daemon automatically",
        "defaultValue": true
      },
      {
        "key": "notifyTransfers",
        "type": "boolean",
        "label": "Notify uploads, downloads and errors",
        "defaultValue": true
      }
    ]
  }
}